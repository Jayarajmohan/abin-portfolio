# Copy to .env.local. Values are baked into the static build, so rebuild after changing them.

# Contact form: free access key from https://web3forms.com (enquiries are emailed
# to the address you sign up with). Public by design.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Production URL, used for the sitemap (e.g. https://abin-remanan-portfolio.web.app)
SITE_URL=https://example.com
